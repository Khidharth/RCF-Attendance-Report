<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Dashboard | RCF Attendance Report</title>
  <script>
    (function () {
      var theme = "dark";
      try { theme = localStorage.getItem("rcf-theme") === "light" ? "light" : "dark"; } catch (e) {}
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <style>
:root, :root[data-theme="dark"] {
  --bg:#0d1b2e; --surface:#14263d; --surface-2:#1b3150; --text:#eaeef4; --text-muted:#a9b6c8; --border:#2a4160;
  --gold:#c9a961; --gold-strong:#d8bb74; --gold-soft:rgba(201,169,97,.14); --on-gold:#1a1405;
  --danger:#f0a0a0; --danger-bg:#3a1d22; --success:#8fd19e; --success-bg:#17301f; --focus:#e6cd92;
  --shadow:0 8px 24px rgba(0,0,0,.25); color-scheme:dark;
}
:root[data-theme="light"] {
  --bg:#f7f5f0; --surface:#fff; --surface-2:#efece4; --text:#1d2733; --text-muted:#5a6675; --border:#d9d4c7;
  --gold:#8f6f1f; --gold-strong:#7a5d15; --gold-soft:rgba(143,111,31,.1); --on-gold:#fff;
  --danger:#8a1f1f; --danger-bg:#fbeaea; --success:#25623a; --success-bg:#e8f3ea; --focus:#8f6f1f;
  --shadow:0 8px 24px rgba(29,39,51,.08); color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;min-height:100vh;display:flex;flex-direction:column;background:var(--bg);color:var(--text);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.6;overflow-x:hidden}
h1,h2,h3{margin:0;line-height:1.2}
p{margin:0 0 12px}
.muted{color:var(--text-muted)}
.small{font-size:.9rem}
.container{width:100%;max-width:1100px;margin:0 auto;padding:0 16px}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.eyebrow{margin:0 0 6px;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;font-weight:600}

/* Header */
.site-header{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--border)}
.header-inner{display:flex;align-items:center;gap:10px;padding-top:10px;padding-bottom:10px}
.brand{display:flex;align-items:center;gap:12px;min-width:0;margin-right:auto;color:inherit;text-decoration:none}
.brand-mark{flex:none;width:44px;height:44px;display:grid;place-items:center;border:2px solid var(--gold);border-radius:10px;color:var(--gold);font-weight:700;letter-spacing:.05em}
.brand-text{display:flex;flex-direction:column;min-width:0;line-height:1.25}
.brand-name{font-weight:600;font-size:.95rem}
.brand-house{color:var(--gold);font-size:.85rem}
.theme-toggle{flex:none;width:44px;height:44px;padding:0;display:inline-grid;place-items:center;background:var(--surface-2);color:var(--gold);border:1px solid var(--border);border-radius:50%;cursor:pointer}
.theme-toggle:hover{border-color:var(--gold);background:var(--gold-soft)}
.theme-toggle svg{width:20px;height:20px}
.icon-moon{display:none}
:root[data-theme="light"] .icon-sun{display:none}
:root[data-theme="light"] .icon-moon{display:block}

/* Buttons + forms */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:10px;border:1px solid transparent;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
.btn-lg{min-height:52px;font-size:1.02rem}
.btn-block{width:100%}
.btn-primary{background:var(--gold);color:var(--on-gold)}
.btn-primary:hover{background:var(--gold-strong)}
.btn-secondary{background:transparent;color:var(--text);border-color:var(--border)}
.btn-secondary:hover{border-color:var(--gold)}
.btn:disabled{opacity:.6;cursor:not-allowed}
.field{margin:0 0 18px}
label{display:block;margin-bottom:6px;font-weight:600}
input[type=text],input[type=email],input[type=password]{width:100%;min-height:48px;padding:10px 12px;font:inherit;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px}
input:hover{border-color:var(--gold)}
.alert{padding:12px 14px;margin-bottom:18px;border-radius:10px}
.alert-error{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger)}
.alert-info{background:var(--gold-soft);border:1px solid var(--border)}

/* Footer */
.site-footer{padding:20px 0;text-align:center;color:var(--text-muted);font-size:.9rem;background:var(--surface);border-top:1px solid var(--border)}
.site-footer p{margin:4px 0}
.footer-values{color:var(--gold);letter-spacing:.05em}

body:not(.ready) .shell, body:not(.ready) .page-head{visibility:hidden}  /* nothing private shows before the login check passes */
.loading{padding:48px 0;text-align:center;color:var(--text-muted)}
body.ready .loading{display:none}

.btn-sm{min-height:44px;padding:0 12px;white-space:nowrap}
.logout-text{display:none}
@media(min-width:640px){.btn-sm{padding:0 16px}.logout-text{display:inline}}

.shell{flex:1;display:grid;gap:16px;padding-top:8px;padding-bottom:40px}
.page-head{padding-top:20px;padding-bottom:6px}
.page-head h1{font-size:1.6rem}
.role-badge{display:inline-block;margin-left:8px;padding:2px 10px;font-size:.75rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold);border-radius:999px;vertical-align:middle}

/* Navigation: scrolling tab row on phones, side menu on larger screens */
.side-nav{display:flex;gap:4px;overflow-x:auto;padding:4px 0;border-bottom:1px solid var(--border);scrollbar-width:none}
.side-nav::-webkit-scrollbar{display:none}
.nav-item{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;color:var(--text-muted);text-decoration:none;font-weight:600;border-bottom:3px solid transparent;white-space:nowrap}
.nav-item[aria-current="page"]{color:var(--gold);border-bottom-color:var(--gold)}
.nav-item.is-disabled{opacity:.55;cursor:default}
.soon{font-size:.68rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:1px 7px;border:1px solid var(--border);border-radius:999px}

@media(min-width:900px){
  .shell{grid-template-columns:220px 1fr;align-items:start;gap:28px}
  .side-nav{flex-direction:column;overflow:visible;border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:8px;position:sticky;top:88px}
  .nav-item{border-bottom:0;border-radius:10px;padding:0 12px}
  .nav-item[aria-current="page"]{background:var(--gold-soft)}
}

/* Cards */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:20px}
.stat{padding:16px;background:var(--surface);border:1px solid var(--border);border-top:3px solid var(--gold);border-radius:12px}
.stat-value{display:block;font-size:1.9rem;font-weight:700;line-height:1.1}
.stat-label{display:block;margin-top:4px;color:var(--text-muted);font-size:.9rem}
.stat.wide{grid-column:1/-1}
@media(min-width:700px){.stats{grid-template-columns:repeat(5,1fr)}.stat.wide{grid-column:auto}}

.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px}
.card h2{font-size:1.15rem;margin-bottom:12px}
.empty{padding:28px 12px;text-align:center;color:var(--text-muted)}

/* Table that turns into stacked cards on phones */
table{width:100%;border-collapse:collapse}
th{text-align:left;color:var(--text-muted);font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
th,td{padding:10px 8px;border-bottom:1px solid var(--border)}
.pill{display:inline-block;padding:2px 10px;font-size:.82rem;background:var(--gold-soft);border-radius:999px}
@media(max-width:639px){
  thead{display:none}
  tr{display:block;padding:10px 0;border-bottom:1px solid var(--border)}
  td{display:flex;justify-content:space-between;gap:12px;padding:4px 0;border:0;text-align:right}
  td::before{content:attr(data-label);color:var(--text-muted);text-align:left}
  td:first-child{font-weight:600}
}

  </style>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="dashboard.html" aria-label="RCF Attendance Report dashboard">
        <span class="brand-mark" aria-hidden="true">RCF</span>
        <span class="brand-text">
          <span class="brand-name">Redeem Christian Fellowship</span>
          <span class="brand-house">House of Revealed God's Glory</span>
        </span>
      </a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode">
          <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      <button id="logout-btn" class="btn btn-secondary btn-sm" type="button" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        <span class="logout-text">Log out</span>
      </button>
    </div>
  </header>

  <div class="container">
    <p id="loading" class="loading" role="status">Checking your login…</p>
    <div id="fatal" class="alert alert-error" role="alert" hidden style="margin-top:20px"></div>
  </div>

  <div class="container page-head">
    <p class="eyebrow">Attendance Report</p>
    <h1 id="welcome">Dashboard</h1>
  </div>

  <div class="container shell">
    <nav class="side-nav" aria-label="Dashboard">
      <a class="nav-item" href="dashboard.html" aria-current="page">Overview</a>
      <span class="nav-item is-disabled" aria-disabled="true">Attendance <span class="soon">Soon</span></span>
      <span class="nav-item is-disabled" aria-disabled="true">Members <span class="soon">Soon</span></span>
      <span class="nav-item is-disabled" aria-disabled="true">Reports <span class="soon">Soon</span></span>
      <span class="nav-item is-disabled" aria-disabled="true">QR &amp; Link <span class="soon">Soon</span></span>
      <span id="nav-workers" class="nav-item is-disabled" aria-disabled="true" hidden>Workers <span class="soon">Soon</span></span>
      <span class="nav-item is-disabled" aria-disabled="true">Settings <span class="soon">Soon</span></span>
    </nav>

    <section aria-labelledby="overview-title">
      <h2 id="overview-title" style="margin-bottom:6px">Overview</h2>
      <p class="muted small" style="margin-bottom:14px">These figures count people who have <strong>registered</strong>. Attendance figures arrive with the attendance feature.</p>

      <div id="load-error" class="alert alert-error" role="alert" hidden></div>

      <div class="stats" id="stats">
        <div class="stat wide"><span class="stat-value" id="stat-total">–</span><span class="stat-label">Total registered</span></div>
        <div class="stat"><span class="stat-value" id="stat-today">–</span><span class="stat-label">Registered today</span></div>
        <div class="stat"><span class="stat-value" id="stat-first">–</span><span class="stat-label">First Timers</span></div>
        <div class="stat"><span class="stat-value" id="stat-convert">–</span><span class="stat-label">New Converts</span></div>
        <div class="stat"><span class="stat-value" id="stat-member">–</span><span class="stat-label">Members</span></div>
      </div>

      <div class="card">
        <h2>Latest registrations</h2>
        <div id="recent-empty" class="empty" hidden>No registrations yet. They will appear here as soon as someone registers.</div>
        <table id="recent-table" hidden>
          <thead><tr><th>Name</th><th>Level</th><th>Category</th><th>Date</th></tr></thead>
          <tbody id="recent-body"></tbody>
        </table>
      </div>
    </section>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p class="footer-values">Worship · Fellowship · Discipleship · Impact</p>
      <p>© <span id="year"></span> RCF Attendance Report. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase-config.js"></script>
  <script>

// ---- Settings: read from supabase-config.js (loaded before this script) ----
var config = window.RCF_CONFIG || {};
var configured = !!(config.SUPABASE_URL && config.SUPABASE_ANON_KEY &&
  config.SUPABASE_URL.indexOf("PASTE_") !== 0 && config.SUPABASE_ANON_KEY.indexOf("PASTE_") !== 0);
var client = (configured && window.supabase)
  ? window.supabase.createClient(config.SUPABASE_URL, config.SUPABASE_ANON_KEY)
  : null;

// ---- Theme toggle (icon button) ----
(function () {
  var root = document.documentElement;
  var button = document.getElementById("theme-toggle");
  function render(theme) {
    button.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
  }
  render(root.getAttribute("data-theme") || "dark");
  button.addEventListener("click", function () {
    var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("rcf-theme", next); } catch (e) {}
    render(next);
  });
})();
document.getElementById("year").textContent = new Date().getFullYear();

// ---- Dashboard ----
(function () {
  var loading = document.getElementById("loading");
  var fatal = document.getElementById("fatal");

  function goToLogin(denied) {
    window.location.replace("login.html" + (denied ? "?denied=1" : ""));
  }

  document.getElementById("logout-btn").addEventListener("click", async function () {
    if (client) await client.auth.signOut();
    goToLogin(false);
  });

  function stopWithMessage(message) {
    loading.hidden = true;
    fatal.textContent = message;
    fatal.hidden = false;
  }

  // Church calendar date (Africa/Lagos) as YYYY-MM-DD, to count "registered today".
  function todayInChurchTimezone() {
    return new Intl.DateTimeFormat("en-CA", { timeZone: config.TIMEZONE || "Africa/Lagos" }).format(new Date());
  }

  function formatDate(isoDate) {
    var parts = String(isoDate).split("-");
    var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
    return new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" }).format(d);
  }

  function countOf(result) {
    if (result.error) throw result.error;
    return result.count || 0;
  }

  async function loadOverview() {
    try {
      var members = function () { return client.from("members").select("*", { count: "exact", head: true }); };
      var results = await Promise.all([
        members(),
        members().eq("registered_on", todayInChurchTimezone()),
        members().eq("registration_category", "First Timer"),
        members().eq("registration_category", "New Convert"),
        members().eq("registration_category", "Member"),
        client.from("members")
          .select("full_name, level, registration_category, registered_on")
          .order("registered_at", { ascending: false })
          .limit(10),
      ]);

      document.getElementById("stat-total").textContent = countOf(results[0]);
      document.getElementById("stat-today").textContent = countOf(results[1]);
      document.getElementById("stat-first").textContent = countOf(results[2]);
      document.getElementById("stat-convert").textContent = countOf(results[3]);
      document.getElementById("stat-member").textContent = countOf(results[4]);

      var recent = results[5];
      if (recent.error) throw recent.error;
      var rows = recent.data || [];
      var tbody = document.getElementById("recent-body");
      tbody.textContent = "";
      if (rows.length === 0) {
        document.getElementById("recent-empty").hidden = false;
        return;
      }
      rows.forEach(function (row) {
        var tr = document.createElement("tr");
        function cell(label, value, asPill) {
          var td = document.createElement("td");
          td.setAttribute("data-label", label);
          if (asPill) {
            var span = document.createElement("span");
            span.className = "pill";
            span.textContent = value;   // textContent keeps visitor-typed text safe
            td.appendChild(span);
          } else {
            td.textContent = value;
          }
          tr.appendChild(td);
        }
        cell("Name", row.full_name);
        cell("Level", row.level);
        cell("Category", row.registration_category, true);
        cell("Date", formatDate(row.registered_on));
        tbody.appendChild(tr);
      });
      document.getElementById("recent-table").hidden = false;
    } catch (err) {
      console.error("Could not load overview:", err);
      var box = document.getElementById("load-error");
      box.textContent = "We couldn't load the figures. Please refresh the page. If it keeps happening, contact an administrator.";
      box.hidden = false;
    }
  }

  async function start() {
    if (!client) {
      stopWithMessage("The dashboard is not set up yet. The site's Supabase settings are missing.");
      return;
    }
    var session = await client.auth.getSession();
    if (!session.data || !session.data.session) { goToLogin(false); return; }

    // The database answers whether this person is allowed. No profile = no access.
    var userId = session.data.session.user.id;
    var profile = await client.from("profiles").select("full_name, role, is_active").eq("id", userId).maybeSingle();
    if (profile.error || !profile.data || profile.data.is_active !== true) {
      await client.auth.signOut();
      goToLogin(true);
      return;
    }

    var firstName = profile.data.full_name.split(" ")[0];
    var heading = document.getElementById("welcome");
    heading.textContent = "Welcome, " + firstName;
    var badge = document.createElement("span");
    badge.className = "role-badge";
    badge.textContent = profile.data.role === "admin" ? "Admin" : "Worker";
    heading.appendChild(badge);
    if (profile.data.role === "admin") document.getElementById("nav-workers").hidden = false;

    document.body.classList.add("ready");
    loadOverview();

    // If the session ends in another tab, leave the dashboard.
    client.auth.onAuthStateChange(function (event) { if (event === "SIGNED_OUT") goToLogin(false); });
  }

  start();
})();
  </script>
</body>
</html>
