// Possible duplicates: the same phone number, or the same name. Only a person decides what is a real duplicate.
function findDuplicateGroups() {
  var parent = {};
  function find(x) { while (parent[x] !== x) { parent[x] = parent[parent[x]]; x = parent[x]; } return x; }
  function union(a, b) { parent[find(a)] = find(b); }
  state.members.forEach(function (m) { parent[m.id] = m.id; });
  var byPhone = {}, byName = {}, why = {};
  state.members.forEach(function (m) {
    if (m._phone.length >= 10) (byPhone[m._phone] = byPhone[m._phone] || []).push(m);
    if (m._name.length >= 4) (byName[m._name] = byName[m._name] || []).push(m);
  });
  [[byPhone, "same phone number"], [byName, "same name"]].forEach(function (pair) {
    Object.keys(pair[0]).forEach(function (k) {
      var arr = pair[0][k];
      if (arr.length < 2) return;
      arr.forEach(function (m) { union(arr[0].id, m.id); });
      arr.forEach(function (m) { (why[m.id] = why[m.id] || {})[pair[1]] = 1; });
    });
  });
  var groups = {};
  state.members.forEach(function (m) { var r = find(m.id); (groups[r] = groups[r] || []).push(m); });
  var dismissed = dismissedSet();
  return Object.keys(groups).map(function (r) {
    var g = groups[r];
    if (g.length < 2) return null;
    var key = g.map(function (m) { return m.id; }).sort().join("|"), reasons = {};
    g.forEach(function (m) { Object.keys(why[m.id] || {}).forEach(function (w) { reasons[w] = 1; }); });
    return { key: key, members: g, reasons: Object.keys(reasons) };
