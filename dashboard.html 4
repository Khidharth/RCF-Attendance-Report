    '</cellXfs>' +
    '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>' +
    '</styleSheet>';

  function safeSheetName(name, used) {
    var n = String(name).replace(/[\[\]:*?\/\\]/g, " ").trim().slice(0, 31) || "Sheet";
    var base = n, i = 2;
