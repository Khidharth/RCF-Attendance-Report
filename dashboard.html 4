  var err = h("div", { class: "alert alert-error", role: "alert", hidden: true });
  var addErr = h("div", { class: "alert alert-error", role: "alert", hidden: true });
  var listBox = h("div", null, h("p", { class: "muted", text: "Loading…" }));
  var email = h("input", { id: "wk-email", type: "email", autocomplete: "off", inputmode: "email" });
  var name = h("input", { id: "wk-name", type: "text", maxlength: "120", autocomplete: "off" });
  var role = h("select", { id: "wk-role" }, h("option", { value: "worker", text: "Attendance worker" }), h("option", { value: "admin", text: "Administrator" }));
  var addForm = h("form", { novalidate: true }, addErr,
    h("div", { class: "form-grid" },
      h("div", { class: "field" }, h("label", { for: "wk-email", text: "Their email" }), email),
      h("div", { class: "field" }, h("label", { for: "wk-name", text: "Their name" }), name),
      h("div", { class: "field" }, h("label", { for: "wk-role", text: "Role" }), role)),
    h("button", { type: "submit", class: "btn btn-primary", text: "Give access" }));
  addForm.addEventListener("submit", async function (e) {
    e.preventDefault(); addErr.hidden = true;
    var btn = addForm.querySelector("[type=submit]"); btn.disabled = true;
    try {
      await rpc("admin_set_role", { p_email: email.value.trim(), p_full_name: name.value.trim(), p_role: role.value });
      toast("Access given."); email.value = ""; name.value = ""; await load();
    } catch (ex) { showBox(addErr, ex.message); }
    btn.disabled = false;
  });
  view.appendChild(h("div", { class: "card" }, h("h2", { text: "Who has access" }), err, listBox));
  view.appendChild(h("div", { class: "card" }, h("h2", { text: "Give someone access" }),
    h("ol", { class: "steps" },
      h("li", { text: "In Supabase, open Authentication → Users → Add user, and create their login (email and password). Tick “Auto Confirm User”." }),
      h("li", { text: "Come back here, enter the same email and their name, choose a role, and press Give access." }),
      h("li", { text: "Share their password with them privately. They sign in at the Staff Login page." })),
    addForm,
    h("p", { class: "muted small", text: "Attendance workers can mark attendance and view members. Administrators can also edit members, see reports, and manage workers. To reset someone's password, use Authentication → Users in Supabase." })));

  async function setStaff(p, newRole, active, title, text, label, danger) {
    if (!(await confirmDialog(title, text, label, danger))) return;
    try { await rpc("admin_update_staff", { p_id: p.id, p_role: newRole, p_is_active: active }); toast("Saved."); await load(); }
    catch (ex) { toast(ex.message, "error"); }
  }
  async function load() {
    try {
      var staff = (await rpc("admin_list_staff")) || [];
      clear(listBox);
      listBox.appendChild(h("table", { class: "table" },
        h("thead", null, h("tr", null, ["Name", "Email", "Role", "Status", ""].map(function (t) { return h("th", { text: t }); }))),
        h("tbody", null, staff.map(function (p) {
          var me = p.id === state.user.id;
          return h("tr", null,
            h("td", { "data-label": "Name" }, h("strong", { text: p.full_name }), me ? h("span", { class: "pill pill-note", text: "You" }) : null),
            h("td", { "data-label": "Email", text: p.email || "–" }),
            h("td", { "data-label": "Role", text: p.role === "admin" ? "Administrator" : "Attendance worker" }),
            h("td", { "data-label": "Status" }, h("span", { class: "pill " + (p.is_active ? "pill-present" : "pill-absent"), text: p.is_active ? "Active" : "No access" })),
            h("td", { class: "row-actions" }, me ? null : [
              h("button", { type: "button", class: "btn btn-secondary btn-sm", text: p.role === "admin" ? "Make worker" : "Make admin",
                on: { click: function () { var nr = p.role === "admin" ? "worker" : "admin"; setStaff(p, nr, p.is_active, "Change role?", p.full_name + " will become " + (nr === "admin" ? "an administrator." : "an attendance worker."), "Change role", false); } } }),
              h("button", { type: "button", class: "btn btn-secondary btn-sm", text: p.is_active ? "Remove access" : "Restore access",
                on: { click: function () { setStaff(p, p.role, !p.is_active, p.is_active ? "Remove access?" : "Restore access?", p.is_active ? p.full_name + " will be signed out of the dashboard and will not be able to sign in." : p.full_name + " will be able to sign in again.", p.is_active ? "Remove access" : "Restore", p.is_active); } } })]));
        }))));
    } catch (ex) { clear(listBox); showBox(err, ex.message); }
  }
  await load();
}

// ---------------------------------------------------------------- 9. SETTINGS
function displayName(profile) {
  var n = String((profile && profile.full_name) || "").trim();
  if (!n || n.indexOf("@") !== -1 || /^[0-9a-f]{8}-[0-9a-f]{4}-/i.test(n)) return "";
  return n;
}
function refreshHeaderUser() {
  var n = displayName(state.profile), first = n ? n.split(/\s+/)[0] : "";
  $("welcome").textContent = first ? "Welcome, " + first : "Welcome";
  $("user-chip-name").textContent = n || "Your account";
  $("user-chip-role").textContent = state.isAdmin ? "Admin" : "Worker";
  $("user-chip-avatar").textContent = (first || "?").charAt(0).toUpperCase();
}

async function initSettings() {
  var view = clear($("view-settings"));
  var nameInput = h("input", { id: "set-name", type: "text", maxlength: "120", value: displayName(state.profile), autocomplete: "name" });
  var nameMsg = h("div", { class: "alert", role: "status", hidden: true });
  var nameForm = h("form", { novalidate: true }, nameMsg,
    h("div", { class: "field" }, h("label", { for: "set-name", text: "Your name (shown in the dashboard)" }), nameInput),
    h("button", { type: "submit", class: "btn btn-primary", text: "Save name" }));
  if (!displayName(state.profile)) showBox(nameMsg, "Your name has not been set yet. Add it here so the dashboard can greet you properly.", "info");
  nameForm.addEventListener("submit", async function (e) {
    e.preventDefault(); nameMsg.hidden = true;
    var btn = nameForm.querySelector("[type=submit]"); btn.disabled = true;
    try {
      await rpc("update_my_name", { p_name: nameInput.value });
      state.profile.full_name = nameInput.value.trim(); refreshHeaderUser(); showBox(nameMsg, "Saved.", "success");
    } catch (ex) { showBox(nameMsg, ex.message); }
    btn.disabled = false;
  });

  var pw1 = h("input", { id: "set-pw1", type: "password", autocomplete: "new-password" }), pw2 = h("input", { id: "set-pw2", type: "password", autocomplete: "new-password" });
  var pwMsg = h("div", { class: "alert", role: "status", hidden: true });
  var pwForm = h("form", { novalidate: true }, pwMsg,
    h("div", { class: "field" }, h("label", { for: "set-pw1", text: "New password" }), pw1, h("p", { class: "muted small", text: "At least 8 characters." })),
    h("div", { class: "field" }, h("label", { for: "set-pw2", text: "Type it again" }), pw2),
    h("button", { type: "submit", class: "btn btn-primary", text: "Change password" }));
  pwForm.addEventListener("submit", async function (e) {
    e.preventDefault(); pwMsg.hidden = true;
    if (pw1.value.length < 8) { showBox(pwMsg, "Please use at least 8 characters."); return; }
    if (pw1.value !== pw2.value) { showBox(pwMsg, "The two passwords do not match."); return; }
    var btn = pwForm.querySelector("[type=submit]"); btn.disabled = true;
    try {
      var res = await client.auth.updateUser({ password: pw1.value });
      if (res.error) throw new Error(res.error.message);
      pw1.value = ""; pw2.value = ""; showBox(pwMsg, "Password changed.", "success");
    } catch (ex) { showBox(pwMsg, ex.message); }
    btn.disabled = false;
  });

  view.appendChild(h("div", { class: "card" }, h("h2", { text: "Your profile" }),
    h("dl", { class: "kvs" }, h("div", { class: "kv" }, h("dt", { text: "Login email" }), h("dd", { text: state.user.email || "–" })),
      h("div", { class: "kv" }, h("dt", { text: "Role" }), h("dd", { text: state.isAdmin ? "Administrator" : "Attendance worker" }))), nameForm));
  view.appendChild(h("div", { class: "card" }, h("h2", { text: "Password" }), pwForm));
  view.appendChild(h("div", { class: "card" }, h("h2", { text: "About" }),
    h("dl", { class: "kvs" }, h("div", { class: "kv" }, h("dt", { text: "Church" }), h("dd", { text: "Redeem Christian Fellowship · House of God's Revealed Glory" })),
      h("div", { class: "kv" }, h("dt", { text: "Dates and times use" }), h("dd", { text: config.TIMEZONE })))));
}

// ---------------------------------------------------------------- 10. START-UP
function goToLogin(denied) { window.location.replace("login.html" + (denied ? "?denied=1" : "")); }

(async function start() {
  document.querySelectorAll(".year").forEach(function (el) { el.textContent = new Date().getFullYear(); });
  // theme toggle
  (function () {
    var root = document.documentElement, button = $("theme-toggle");
    function render(theme) { button.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode"); }
    render(root.getAttribute("data-theme") || "dark");
    button.addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("rcf-theme", next); } catch (e) {}
      render(next);
    });
  })();
  $("logout-btn").addEventListener("click", async function () { if (client) await client.auth.signOut(); goToLogin(false); });
  $("menu-btn").addEventListener("click", function () { if ($("drawer").hidden) openDrawer(); else closeDrawer(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDrawer(); });
  $("drawer-backdrop").addEventListener("click", closeDrawer);

  var fatal = $("fatal"), loading = $("loading");
  function stop(message) { loading.hidden = true; fatal.textContent = message; fatal.hidden = false; }
  if (!client) { stop("The dashboard is not set up yet. The site's Supabase settings are missing."); return; }

  var session = await client.auth.getSession();
  if (!session.data || !session.data.session) { goToLogin(false); return; }
  state.user = session.data.session.user;

  // The database decides who may enter. No active profile = no access.
  var profile = await client.from("profiles").select("full_name, role, is_active").eq("id", state.user.id).maybeSingle();
  if (profile.error || !profile.data || profile.data.is_active !== true) { await client.auth.signOut(); goToLogin(true); return; }
  state.profile = profile.data;
  state.isAdmin = profile.data.role === "admin";

  buildNav(); refreshHeaderUser();
  document.body.classList.add("ready");
  loading.hidden = true;
  window.addEventListener("hashchange", showRoute);
  client.auth.onAuthStateChange(function (event) { if (event === "SIGNED_OUT") goToLogin(false); });
  showRoute();
})();

  </script>
