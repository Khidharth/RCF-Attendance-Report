// Simple bar chart (one colour, labelled values, hover text). Drawn as SVG so it scales on phones.
function barChart(points, opts) {
  opts = opts || {};
  var W = 520, H = 240, padL = 30, padR = 8, padT = 24, padB = 44;
  var max = Math.max.apply(null, points.map(function (p) { return p.value; }).concat([1]));
  var n = points.length, slot = (W - padL - padR) / n, bw = Math.max(6, Math.min(36, slot * 0.6));
  var svg = document.createElementNS(SVG_NS, "svg");
  svg.setAttribute("viewBox", "0 0 " + W + " " + H); svg.setAttribute("class", "chart");
  svg.setAttribute("role", "img"); svg.setAttribute("aria-label", opts.label || "Bar chart");
  function el(tag, attrs, text) {
    var e = document.createElementNS(SVG_NS, tag);
    Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });
    if (text !== undefined) e.textContent = text;
    return e;
  }
  svg.appendChild(el("line", { x1: padL, x2: W - padR, y1: H - padB, y2: H - padB, class: "chart-axis" }));
  [0.5, 1].forEach(function (f) {
    var y = H - padB - (H - padB - padT) * f;
    svg.appendChild(el("line", { x1: padL, x2: W - padR, y1: y, y2: y, class: "chart-grid" }));
    svg.appendChild(el("text", { x: padL - 4, y: y + 4, class: "chart-tick", "text-anchor": "end" }, String(Math.round(max * f))));
  });
  var showEvery = n > 9 ? Math.ceil(n / 9) : 1;
  points.forEach(function (p, i) {
    var cx = padL + slot * i + slot / 2, bh = (H - padB - padT) * (p.value / max);
    var g = el("g", {});
    g.appendChild(el("title", {}, p.tip || (p.label + ": " + p.value)));
    // rounded top, flat on the baseline
    var x = cx - bw / 2, y = H - padB - bh, r = Math.min(4, bw / 2, bh);
    var d = bh <= 0 ? "" : "M" + x + "," + (H - padB) + "V" + (y + r) + "Q" + x + "," + y + " " + (x + r) + "," + y + "H" + (x + bw - r) + "Q" + (x + bw) + "," + y + " " + (x + bw) + "," + (y + r) + "V" + (H - padB) + "Z";
    if (d) g.appendChild(el("path", { d: d, class: "chart-bar" }));
    g.appendChild(el("rect", { x: cx - slot / 2, y: padT, width: slot, height: H - padB - padT, fill: "transparent" })); // bigger hover target
    if (n <= 16) g.appendChild(el("text", { x: cx, y: y - 5, class: "chart-value", "text-anchor": "middle" }, String(p.value)));
    if (i % showEvery === 0) g.appendChild(el("text", { x: cx, y: H - padB + 16, class: "chart-label", "text-anchor": "middle" }, p.label));
    svg.appendChild(g);
  });
  return svg;
}

