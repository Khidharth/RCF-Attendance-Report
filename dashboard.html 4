function phoneKey(phone) {
  var d = String(phone || "").replace(/\D/g, "");
  if (d.length === 13 && d.indexOf("234") === 0) d = "0" + d.slice(3);
  else if (d.length === 10 && d[0] !== "0") d = "0" + d;
  return d;
}
function nameKey(name) { return String(name || "").toLowerCase().replace(/[^a-z0-9\u00C0-\uFFFF ]/g, "").replace(/\s+/g, " ").trim(); }

async function loadMembers(force) {
  if (state.members && !force) return state.members;
  var rows = await rpcAll("list_members");
  rows.forEach(function (m) {
    m._name = nameKey(m.full_name);
    m._phone = phoneKey(m.phone);
    m._search = (m.full_name + " " + (m.phone || "") + " " + m._phone).toLowerCase();
  });
  state.members = rows;
  state.membersById = {};
  rows.forEach(function (m) { state.membersById[m.id] = m; });
  return rows;
}
function matchesSearch(m, query) {
  var q = String(query || "").trim().toLowerCase();
  if (!q) return true;
  var digits = q.replace(/\D/g, "");
  return q.split(/\s+/).every(function (part) { return m._search.indexOf(part) !== -1; }) ||
         (digits.length >= 4 && m._phone.indexOf(phoneKey(digits)) !== -1);
}

