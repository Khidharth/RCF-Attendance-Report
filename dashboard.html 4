<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Dashboard | RCF Attendance Report</title>
  <link rel="icon" href="logo.jpg" />
  <script>
    (function () {
      var theme = "dark";
      try { theme = localStorage.getItem("rcf-theme") === "light" ? "light" : "dark"; } catch (e) {}
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <style>
:root, :root[data-theme="dark"] {
  --bg:#0d1b2e; --surface:#14263d; --surface-2:#1b3150; --text:#eaeef4; --text-muted:#a9b6c8; --border:#2a4160;
  --gold:#c9a961; --gold-strong:#d8bb74; --gold-soft:rgba(201,169,97,.14); --on-gold:#1a1405;
  --danger:#f0a0a0; --danger-bg:#3a1d22; --success:#8fd19e; --success-bg:#17301f; --focus:#e6cd92;
  --shadow:0 8px 24px rgba(0,0,0,.25); color-scheme:dark;
}
:root[data-theme="light"] {
  --bg:#f7f5f0; --surface:#fff; --surface-2:#efece4; --text:#1d2733; --text-muted:#5a6675; --border:#d9d4c7;
  --gold:#8f6f1f; --gold-strong:#7a5d15; --gold-soft:rgba(143,111,31,.1); --on-gold:#fff;
  --danger:#8a1f1f; --danger-bg:#fbeaea; --success:#25623a; --success-bg:#e8f3ea; --focus:#8f6f1f;
  --shadow:0 8px 24px rgba(29,39,51,.08); color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;min-height:100vh;display:flex;flex-direction:column;background:var(--bg);color:var(--text);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.6;overflow-x:hidden}
h1,h2,h3{margin:0;line-height:1.2}
p{margin:0 0 12px}
.muted{color:var(--text-muted)}
.small{font-size:.9rem}
.container{width:100%;max-width:1100px;margin:0 auto;padding:0 16px}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.eyebrow{margin:0 0 6px;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;font-weight:600}

/* Header */
.site-header{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--border)}
.header-inner{display:flex;align-items:center;gap:10px;padding-top:10px;padding-bottom:10px}
.brand{display:flex;align-items:center;gap:12px;min-width:0;margin-right:auto;color:inherit;text-decoration:none}
.brand-mark{flex:none;width:44px;height:44px;display:block;position:relative;overflow:hidden;background:#3a0f05;border:2px solid var(--gold);border-radius:10px}
.brand-mark img{display:block;width:100%;height:100%;object-fit:cover;transform:translateY(-26%) scale(2.2)}
.brand-text{display:flex;flex-direction:column;min-width:0;line-height:1.25}
.brand-name{font-weight:600;font-size:.95rem}
.brand-house{color:var(--gold);font-size:.85rem}
.theme-toggle{flex:none;width:44px;height:44px;padding:0;display:inline-grid;place-items:center;background:var(--surface-2);color:var(--gold);border:1px solid var(--border);border-radius:50%;cursor:pointer}
.theme-toggle:hover{border-color:var(--gold);background:var(--gold-soft)}
.theme-toggle svg{width:20px;height:20px}
.icon-moon{display:none}
:root[data-theme="light"] .icon-sun{display:none}
:root[data-theme="light"] .icon-moon{display:block}

/* Buttons + forms */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:10px;border:1px solid transparent;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
.btn-lg{min-height:52px;font-size:1.02rem}
.btn-block{width:100%}
.btn-primary{background:var(--gold);color:var(--on-gold)}
.btn-primary:hover{background:var(--gold-strong)}
.btn-secondary{background:transparent;color:var(--text);border-color:var(--border)}
.btn-secondary:hover{border-color:var(--gold)}
.btn:disabled{opacity:.6;cursor:not-allowed}
.field{margin:0 0 18px}
label{display:block;margin-bottom:6px;font-weight:600}
input[type=text],input[type=email],input[type=password]{width:100%;min-height:48px;padding:10px 12px;font:inherit;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px}
input:hover{border-color:var(--gold)}
.alert{padding:12px 14px;margin-bottom:18px;border-radius:10px}
.alert-error{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger)}
.alert-info{background:var(--gold-soft);border:1px solid var(--border)}

/* Footer */
.site-footer{padding:20px 0;text-align:center;color:var(--text-muted);font-size:.9rem;background:var(--surface);border-top:1px solid var(--border)}
.site-footer p{margin:4px 0}
.footer-values{color:var(--gold);letter-spacing:.05em}

.sr-label{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.center{text-align:center;margin-top:12px}
.block{display:block}
.grow{flex:1 1 220px}
.small{font-size:.88rem}
.ok-text{color:var(--success)}
input[type=search],input[type=url],input[type=date],select{width:100%;min-height:48px;padding:10px 12px;font:inherit;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px}
select{appearance:auto}
input[type=date]{min-width:0}
input[type=checkbox]{width:20px;height:20px;accent-color:var(--gold)}
.check{display:flex;align-items:center;gap:10px;margin:8px 0 14px;font-weight:500}
body:not(.ready) .shell,body:not(.ready) .page-head{visibility:hidden}
.loading{padding:48px 0;text-align:center;color:var(--text-muted)}
.btn-sm{min-height:44px;padding:0 14px;white-space:nowrap}
.btn-danger{background:var(--danger-bg);color:var(--danger);border-color:var(--danger)}
.alert-success{background:var(--success-bg);color:var(--success);border:1px solid var(--success)}
.icon-btn{display:inline-grid;place-items:center;width:44px;height:44px;padding:0;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:10px;cursor:pointer}
.icon-btn:hover{border-color:var(--gold);color:var(--gold)}

/* header */
.header-inner{gap:10px}
.menu-btn{flex:none}
.user-chip{display:none;align-items:center;gap:10px;margin-left:4px;padding:4px 12px 4px 4px;border:1px solid var(--border);border-radius:999px;background:var(--surface-2)}
.user-chip-avatar{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:var(--gold);color:var(--on-gold);font-weight:700}
.user-chip-text{display:flex;flex-direction:column;line-height:1.15;min-width:0}
#user-chip-name{font-weight:600;font-size:.9rem;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#user-chip-role{font-size:.72rem;color:var(--gold);text-transform:uppercase;letter-spacing:.07em;font-weight:600}
.logout-text{display:none}
@media(min-width:640px){.user-chip{display:flex}.logout-text{display:inline}.btn-sm{padding:0 16px}}
@media(max-width:399px){.brand-house{display:none}}

/* mobile drawer */
.drawer{position:fixed;inset:0;z-index:40}
.drawer-backdrop{position:absolute;inset:0;background:rgba(5,12,22,.6)}
.drawer-nav{position:absolute;top:0;left:0;bottom:0;width:min(82vw,320px);padding:16px 12px;background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column;gap:4px}
.drawer-nav::before{content:"Menu";display:block;padding:8px 12px 12px;color:var(--gold);text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;font-weight:600}
@media(min-width:900px){.drawer,.menu-btn{display:none!important}}

/* layout */
.page-head{padding-top:18px;padding-bottom:4px}
.page-head h1{font-size:1.5rem}
.shell{flex:1;display:grid;gap:16px;padding-top:8px;padding-bottom:40px;align-items:start}
.side-nav{display:none}
.nav-item{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 14px;color:var(--text-muted);text-decoration:none;font-weight:600;border-radius:10px}
.nav-item:hover{background:var(--surface-2);color:var(--text)}
.nav-item[aria-current="page"]{color:var(--gold);background:var(--gold-soft)}
@media(min-width:900px){
  .shell{grid-template-columns:230px minmax(0,1fr);gap:28px}
  .side-nav{display:flex;flex-direction:column;gap:2px;padding:8px;background:var(--surface);border:1px solid var(--border);border-radius:14px;position:sticky;top:88px}
}
main{min-width:0}
.view-title{font-size:1.25rem;margin:4px 0 14px}
.view[hidden]{display:none}
.section-title{font-size:1.05rem;margin:18px 0 10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em}
.section-title:first-child{margin-top:4px}

/* cards + stats */
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:16px}
.card h2{font-size:1.15rem;margin-bottom:12px}
.card h3{font-size:.95rem;margin:18px 0 8px;color:var(--text-muted)}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:8px}
.stat{padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-top:3px solid var(--gold);border-radius:12px}
.stat-value{display:block;font-size:1.8rem;font-weight:700;line-height:1.1}
.stat-label{display:block;margin-top:4px;font-weight:600;font-size:.92rem}
.stat-hint{display:block;margin-top:2px;color:var(--text-muted);font-size:.8rem}
@media(min-width:700px){.stats{grid-template-columns:repeat(3,1fr)}.stats-3{grid-template-columns:repeat(2,1fr)}}
.stats-3{grid-template-columns:1fr}
@media(min-width:560px){.stats-3{grid-template-columns:repeat(2,1fr)}}
.empty{padding:28px 12px;text-align:center;color:var(--text-muted)}
.empty strong{display:block;color:var(--text);margin-bottom:4px}
.empty .btn{margin-top:10px}
.toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;margin-bottom:14px}
.toolbar-main{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.toolbar-main select{width:auto;min-width:180px}
.toolbar-label{margin:0;color:var(--text-muted);font-size:.9rem}
.toolbar-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}
.toolbar-actions{display:flex;flex-wrap:wrap;gap:8px}
.inline-fields{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.inline-fields input{width:auto}
.date-field{display:flex;flex-direction:column;gap:4px;font-weight:600;font-size:.9rem}
.date-field input{min-width:150px}
.filters{display:flex;flex-wrap:wrap;gap:10px}
.filters .field{margin:0;min-width:150px;flex:0 1 auto}
.filters .field.grow{flex:1 1 240px}
.form-grid{display:grid;gap:0 16px}
@media(min-width:600px){.form-grid{grid-template-columns:repeat(3,1fr)}}

/* tables become cards on phones */
.table{width:100%;border-collapse:collapse}
.table th{text-align:left;color:var(--text-muted);font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.table th,.table td{padding:10px 8px;border-bottom:1px solid var(--border);vertical-align:middle}
.table .num{text-align:right}
.row-total td{font-weight:700;background:var(--gold-soft)}
.row-actions{white-space:nowrap}
.row-actions .btn{margin:2px 4px 2px 0}
@media(max-width:699px){
  .table thead{display:none}
  .table tr{display:block;padding:10px 0;border-bottom:1px solid var(--border)}
  .table td{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:4px 0;border:0;text-align:right}
  .table td::before{content:attr(data-label);color:var(--text-muted);text-align:left;flex:none}
  .table td:first-child{font-weight:600}
  .row-actions{white-space:normal;justify-content:flex-start!important;flex-wrap:wrap}
  .row-actions::before{display:none}
}
.name-btn{font-weight:600;color:var(--text);text-decoration:none;text-align:left;min-height:32px}
.name-btn:hover{color:var(--gold);text-decoration:underline}
.pill{display:inline-block;padding:2px 10px;font-size:.8rem;font-weight:600;background:var(--gold-soft);border:1px solid transparent;border-radius:999px;white-space:nowrap}
.pill-first-timer{border-color:var(--gold)}
.pill-new-convert{border-style:dashed;border-color:var(--gold)}
.pill-present{background:var(--success-bg);color:var(--success);border-color:var(--success)}
.pill-absent{background:var(--danger-bg);color:var(--danger);border-color:var(--danger)}
.pill-note{background:transparent;color:var(--text-muted);border-color:var(--border);margin-left:6px}

/* charts */
.chart-grid-2{display:grid;gap:16px}
@media(min-width:900px){.chart-grid-2{grid-template-columns:3fr 2fr}}
.chart{width:100%;height:auto;display:block}
.chart-axis{stroke:var(--border);stroke-width:1}
.chart-grid{stroke:var(--border);stroke-width:1;stroke-dasharray:3 4;opacity:.7}
.chart-bar{fill:var(--gold)}
.chart-value{fill:var(--text);font-size:13px;font-weight:600}
.chart-label,.chart-tick{fill:var(--text-muted);font-size:12px}
.hbars{display:grid;gap:12px;margin-bottom:14px}
.hbar-row{display:grid;grid-template-columns:96px 1fr 34px;align-items:center;gap:10px;font-size:.9rem}
.hbar-track{height:12px;background:var(--surface-2);border-radius:6px;overflow:hidden}
.hbar-fill{display:block;height:100%;background:var(--gold);border-radius:6px}
.hbar-value{text-align:right;font-weight:600}
.details summary{cursor:pointer;font-weight:600;min-height:32px}
.details-inline{margin:8px 0 14px}
.details-inline summary{cursor:pointer;color:var(--gold);font-weight:600;min-height:32px}

/* attendance */
.att-pick{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px;margin-bottom:6px}
.att-pick .field{margin:0;flex:0 1 220px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 14px}
.chip{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;font:inherit;font-weight:600;color:var(--text);background:var(--surface-2);border:1px solid var(--border);border-radius:999px;cursor:pointer}
.chip[aria-pressed="true"]{border-color:var(--gold);background:var(--gold-soft);color:var(--gold)}
.chip-count{font-weight:500;font-size:.8rem;color:var(--text-muted)}
.new-service{display:flex;flex-wrap:wrap;gap:8px}
.new-service input{flex:1 1 220px;width:auto;min-height:48px;padding:10px 12px;font:inherit;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px}
.svc-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;margin-bottom:10px}
.svc-head h2{margin-bottom:2px}
.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}
.tab{display:flex;flex-direction:column;align-items:center;min-height:56px;padding:6px 4px;font:inherit;font-size:.82rem;color:var(--text-muted);background:var(--surface-2);border:1px solid var(--border);border-radius:10px;cursor:pointer}
.tab-num{font-size:1.25rem;font-weight:700;color:var(--text)}
.tab[aria-pressed="true"]{border-color:var(--gold);background:var(--gold-soft);color:var(--gold)}
.tab[aria-pressed="true"] .tab-num{color:var(--gold)}
.att-list{display:grid;gap:8px}
.att-row{display:grid;gap:10px;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:12px}
.att-row.is-present{border-left:4px solid var(--success)}
.att-row.is-absent{border-left:4px solid var(--danger)}
.att-info{display:flex;flex-direction:column;gap:2px;min-width:0}
.att-info strong{overflow-wrap:anywhere}
.att-tags{margin-top:4px}
.att-actions{display:flex;gap:8px}
.seg{flex:1;min-height:48px;padding:0 12px;font:inherit;font-weight:600;color:var(--text);background:var(--surface-2);border:1px solid var(--border);border-radius:10px;cursor:pointer}
.seg:disabled{opacity:.55;cursor:wait}
.seg-present[aria-pressed="true"]{background:var(--success-bg);color:var(--success);border-color:var(--success)}
.seg-absent[aria-pressed="true"]{background:var(--danger-bg);color:var(--danger);border-color:var(--danger)}
.seg-present[aria-pressed="true"]::before{content:"✓ "}
.seg-clear{flex:0 0 auto;color:var(--text-muted);font-weight:500}
@media(min-width:700px){.att-row{grid-template-columns:1fr auto;align-items:center}.att-actions{min-width:260px}}

/* members */
.dups{margin:12px 0;padding:14px;background:var(--surface-2);border-radius:12px}
.dup-group{padding:10px 0;border-top:1px solid var(--border)}
.dup-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;padding:6px 0}
.kvs{display:grid;gap:8px;margin:12px 0}
.kv{display:flex;justify-content:space-between;gap:16px;padding:6px 0;border-bottom:1px solid var(--border)}
.kv dt{color:var(--text-muted)}.kv dd{margin:0;font-weight:600;text-align:right}
.history{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:6px}
.history li{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)}

/* dialogs + toast */
.dlg{width:min(92vw,460px);max-height:90vh;padding:22px;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow)}
.dlg-wide{width:min(94vw,600px)}
.dlg::backdrop{background:rgba(5,12,22,.65)}
.dlg h2{font-size:1.25rem;margin-bottom:8px}
.dlg-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.dlg-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px;margin-top:18px}
.toast{position:fixed;left:50%;bottom:20px;z-index:60;transform:translateX(-50%);max-width:min(92vw,460px);padding:12px 18px;color:var(--on-gold);background:var(--gold);border-radius:12px;font-weight:600;box-shadow:var(--shadow)}
.toast-error{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger)}
.steps{margin:0 0 14px;padding-left:20px}.steps li{margin-bottom:6px}
.export-bar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px}
.export-bar h2{margin:0}
.export-actions,.csv-group{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.csv-group select{width:auto;min-width:210px}

/* QR */
.qr-card{text-align:center}
.qr-box{width:min(100%,300px);margin:12px auto;padding:10px;background:#fff;border-radius:12px;border:1px solid var(--border)}
.qr-box svg{display:block;width:100%;height:auto}
.qr-url{word-break:break-all;color:var(--text-muted)}
.qr-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:14px}
.print-only-title,.print-sub{display:none}

@media print{
  body *{visibility:hidden}
  #qr-print,#qr-print *{visibility:visible}
  #qr-print{position:absolute;inset:0;border:0;background:#fff;color:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
  #qr-print .eyebrow{color:#555}
  #qr-print .print-only-title{display:block;font-size:2.4rem;margin:6px 0}
  #qr-print .print-sub{display:block;color:#444}
  #qr-print .qr-box{width:380px;border:0}
  #qr-print .qr-url{color:#222;font-size:1rem}
  .no-print{display:none!important}
}

#view-title:focus,.page-head h1:focus{outline:none}
.link-btn{background:none;border:0;padding:0;font:inherit;color:var(--gold);text-decoration:underline;cursor:pointer;min-height:32px}
.link-btn:hover{color:var(--gold-strong)}
.dlg{overflow-y:auto;max-height:88vh}

  </style>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <button id="menu-btn" class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <a class="brand" href="#overview" aria-label="RCF Attendance Report dashboard">
        <span class="brand-mark" aria-hidden="true"><img src="logo.jpg" alt="" width="44" height="44"></span>
        <span class="brand-text">
          <span class="brand-name">Redeem Christian Fellowship</span>
          <span class="brand-house">House of God's Revealed Glory</span>
        </span>
      </a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
